{
  "info": {
    "name": "NexaChain AI Investment Platform",
    "description": "API collection for NexaChain AI MERN Stack Investment & Referral Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "cronSecret", "value": "your-cron-secret-key-change-this" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"Password123\",\n  \"referralCode\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Investments",
      "item": [
        {
          "name": "Create Investment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/investments",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000,\n  \"planName\": \"Starter\"\n}"
            }
          }
        },
        {
          "name": "List Investments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/investments?page=1&limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Get Investment by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/investments/:id",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/summary",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Get Earnings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/earnings?days=30",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "ROI",
      "item": [
        {
          "name": "Get ROI History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/roi/history?page=1&limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Referrals",
      "item": [
        {
          "name": "Get Direct Referrals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/referrals/direct",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Get Referral Tree",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/referrals/tree",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Get Referral Income",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/referrals/income?page=1&limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Internal",
      "item": [
        {
          "name": "Process Daily ROI (Scheduler)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/internal/process-daily-roi",
            "header": [
              { "key": "x-cron-secret", "value": "{{cronSecret}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
